            trace(data.code);
            this.updatecustinfo();
            this.saveimport();
            event.currentTarget.removeEventListener(Event.COMPLETE,this.handleComplete);
         }
         else if(this.handlepick == 4)
         {
            this.fadex.gotoAndPlay("loadfadeout");
            data = JSON.parse(event.target.data);
            trace(data.code);
            this.importedcode = data.code;
            this.chartype = 6;
            this.changeicon = 2;
            this.onlyicon = 1;
            this.onlycolor = 1;
            this.doskew = 2;
