      public function changingleft(e:Event) : void
      {
         var i:* = undefined;
         --this.changetimer;
         if(this.custpage == 20)
         {
            if(this.changetimer < 1)
            {
               this[this.changex + ""] = this[this.changex + ""] - 1;
               if(this[this.changex + ""] < this.minx)
               {
                  this[this.changex + ""] = this.maxx;
               }
               for(i = 2; i <= 10; i++)
               {
                  if(this["oldxpos" + i] != "")
                  {
                     if(this["reverse" + i] == 1)
                     {
                        this[this["oldxpos" + i] + ""] = this[this["oldxpos" + i] + ""] - 1;
                        if(this[this["oldxpos" + i] + ""] < this.minx)
                        {
                           this[this["oldxpos" + i] + ""] = this.maxx;
                        }
                     }
                     else
                     {
                        this[this["oldxpos" + i] + ""] += 1;
                        if(this[this["oldxpos" + i] + ""] > this.maxx)
                        {
                           this[this["oldxpos" + i] + ""] = this.minx;
                        }
                     }
                  }
               }
               this.updatecustinfo();
               this.updatechar();
               this.changetiming();
            }
         }
         else
         {
            if(this.custpage == 18)
            {
               this.changeicon = 2;
            }
            if(this.changetimer < 1)
            {
               this[this.changex + "x"] = this[this.changex + "x"] - 1;
