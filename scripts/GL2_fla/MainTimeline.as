      public function updatesloticons() : void
      {
         var i:* = undefined;
         this.oldslot = this.slot;
         if(this.openslots == 1)
         {
            this.chartype = 3;
            for(i = 1; i <= 8; i++)
            {
               this.slot = i;
               this.getplayerstring();
               this.updatesloticonsgo();
            }
            this.chartype = 1;
            this.slot = this.oldslot;
            this.getplayerstring();
            if(this.slotmain == 1 && this.slot <= 8)
            {
               this.ui.selx.visible = true;
               this.ui.selx.x = this.ui["slotx" + this.slot].x;
               this.ui.selx.y = this.ui["slotx" + this.slot].y;
            }
            else
            {
               this.ui.selx.visible = false;
            }
         }
         else if(this.openslots == 2)
         {
            this.chartype = 3;
            for(i = 1; i <= 8; i++)
            {
               this.slot = i + (this.studiopage * 8 - 8);
               this.getplayerstring();
               this.updatesloticonsgo();
            }
            this.chartype = 1;
            this.slot = this.oldslot;
            this.getplayerstring();
            if(this.slotmain == 1 && this.studiopage == 1 && this.slot <= 8)
            {
               this.slotsgo.selx.x = this.slotsgo["mainslot" + this.slot].x;
               this.slotsgo.selx.y = this.slotsgo["mainslot" + this.slot].y;
            }
            else if(this.slotmain == 1 && this.studiopage == 2 && this.slot >= 9)
            {
               this.slotsgo.selx.x = this.slotsgo["mainslot" + (this.slot - 8)].x;
               this.slotsgo.selx.y = this.slotsgo["mainslot" + (this.slot - 8)].y;
            }
            else
            {
               this.slotsgo.selx.x = -100;
               this.slotsgo.selx.y = -100;
            }
         }
         else if(this.openslots == 3)
         {
            this.chartype = 4;
            i = 1;
            while(i <= 20)
            {
               this.slot = i + (this.slotspage * 20 - 20);
               this.getplayerstring();
               this.updatesloticonsgo();
               i++;
            }
            this.chartype = 1;
            this.slot = this.oldslot;
            this.getplayerstring();
            if(this.slot >= this.slotspage * 20 - 19 && this.slot <= this.slotspage * 20 && this.slotmain == 2)
            {
               this.slotsgo.selx2.x = this.slotsgo["slotx" + (this.slot - (this.slotspage * 20 - 20))].x;
               this.slotsgo.selx2.y = this.slotsgo["slotx" + (this.slot - (this.slotspage * 20 - 20))].y;
            }
            else
            {
               this.slotsgo.selx2.x = -100;
               this.slotsgo.selx2.y = -100;
            }
         }
         else if(this.openslots == 4)
         {
            if(this.studioslotshow == 1)
            {
               this.chartype = 3;
               for(i = 1; i <= 8; i++)
               {
                  this.slot = i;
                  this.getplayerstring();
                  this.updatesloticonsgo();
               }
               this.chartype = 1;
               this.slot = this.oldslot;
               this.getplayerstring();
            }
            else if(this.studioslotshow == 2)
            {
               this.chartype = 3;
               for(i = 1; i <= 8; i++)
               {
                  this.slot = i + 8;
                  this.getplayerstring();
                  this.updatesloticonsgo();
               }
               this.chartype = 1;
               this.slot = this.oldslot;
               this.getplayerstring();
            }
            this.scharui.selx.visible = false;
         }
         else if(this.openslots == 5)
         {
            this.chartype = 1;
            this.slot = this.slot;
            this.getplayerstring();
            this.updatesloticonsgo();
         }
         this.chartype = 1;
         this.onlyicon = 1;
         this.onlycolor = 1;
         this.doskew = 2;
         this.docolor = 2;
      }
      
