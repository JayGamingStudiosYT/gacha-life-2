      public function collectionblockerx(evt:MouseEvent) : void
      {
         var i:* = undefined;
         if(this.gcollect.collectionui.starleftbt.hitTestPoint(stage.mouseX,stage.mouseY,true))
         {
            --this.unitpage;
            this.sfx = 4;
            this.playsfx();
            if(this.unitpage < 1)
            {
               --this.starpage;
               if(this.starpage < 1)
               {
                  this.starpage = 6;
               }
               this.maxunitpage = Math.ceil(this["max" + this.starpage + "stars"] / 10);
               this.unitpage = this.maxunitpage;
            }
            this.updatecollectionchars();
         }
         else if(this.gcollect.collectionui.starrightbt.hitTestPoint(stage.mouseX,stage.mouseY,true))
         {
            this.unitpage += 1;
            this.sfx = 4;
            this.playsfx();
            if(this.unitpage > this.maxunitpage)
            {
               this.starpage += 1;
               if(this.starpage > 6)
               {
                  this.starpage = 1;
               }
               this.unitpage = 1;
            }
            this.updatecollectionchars();
         }
         else
         {
            for(i = 1; i <= 6; i++)
            {
               if(this.gcollect.collectionui["starbt" + i].hitTestPoint(stage.mouseX,stage.mouseY,true))
               {
                  this.starpage = i;
                  this.unitpage = 1;
                  this.updatecollectionchars();
                  this.sfx = 4;
                  this.playsfx();
               }
            }
            for(i = 1; i <= 10; i++)
            {
               if(this["unitx" + (i + this.unitsaddnum)] >= 1)
               {
                  if(this.gcollect["gslot" + i].hitTestPoint(stage.mouseX,stage.mouseY,true))
                  {
                     this.unitpick = i + this.unitsaddnum;
                     this.updatemaincollectchar();
                     this.sfx = 4;
                     this.playsfx();
                  }
               }
            }
         }
      }
      
