      public function tintColor(mc:Sprite, colorNum:Number, alphaSet:Number) : void
      {
         var cTint:Color = new Color();
         cTint.setTint(colorNum,alphaSet);
         mc.transform.colorTransform = cTint;
      }
      
      public function changelayout() : void
      {
         if(this.layout == 1)
         {
            this.phonetype = 1;
            stage.setOrientation(StageOrientation.DEFAULT);
         }
         else if(this.layout >= 2 && this.app == 2)
         {
            stage.setOrientation(StageOrientation.ROTATED_RIGHT);
            if(this.phonesize < 1.76)
            {
               this.layout = 2;
            }
            else if(this.phonesize >= 1.76)
            {
               this.layout = 3;
            }
            if(this.mapx == 4)
            {
               this.updatelayout();
            }
         }
      }
      
      public function handleDeactivate(event:Event) : void
      {
         this.myChannel1.stop();
         this.myChannel2.stop();
         stage.quality = StageQuality.LOW;
         stage.frameRate = 0;
      }
      
      public function handleActivate(event:Event) : void
      {
         this.adload.gotoAndStop(1);
         if(this.mapx == 4)
         {
            if(this.returngems == 2)
            {
               this.mailbox.gotoAndStop(3);
               this["gift" + this.giftpick] = 2;
               this.getgems();
               this.checkgreen();
               this.mailbox.updategifts();
               this.returngems = 1;
            }
         }
         if(this.lag == 1)
         {
            stage.quality = StageQuality.MEDIUM;
         }
         else if(this.lag == 2)
         {
            stage.quality = StageQuality.LOW;
         }
         this.musicplay = 2;
         this.musicplayer();
         stage.frameRate = 30;
      }
      
      public function handleKeyDown(event:KeyboardEvent) : void
      {
         switch(event.keyCode)
         {
            case Keyboard.BACK:
               event.preventDefault();
               event.stopImmediatePropagation();
               break;
            case Keyboard.MENU:
               event.preventDefault();
               event.stopImmediatePropagation();
         }
      }
      
      public function handleKeyUp(event:KeyboardEvent) : void
      {
         switch(event.keyCode)
         {
            case Keyboard.BACK:
               event.preventDefault();
               event.stopImmediatePropagation();
               break;
            case Keyboard.MENU:
               event.preventDefault();
               event.stopImmediatePropagation();
         }
      }
      
      public function opentouchxx(evt:MouseEvent) : void
      {
         if(this.endopening == 1)
         {
            this.endopening = 2;
            this.openingstart();
         }
      }
      
      public function openingstart() : void
      {
         this.fadexx.gotoAndPlay("loadstart");
         this.opentouchx.visible = false;
         removeChild(this.opentouchx);
         this.opentouchx = null;
      }
      
      public function changeload() : void
      {
         this.logox.gotoAndStop(1);
         this.musicplay = 1;
         removeChild(this.logox);
         this.logox = null;
         removeChild(this.startbg);
         this.startbg = null;
         gotoAndStop("loaddata");
      }
      
      public function musicplayer() : void
      {
         this.myTransform1.volume = this.musicvolume / 10;
         if(this.musicplay == 2)
         {
            this.myChannel1.stop();
            if(this.musicpick != 0)
            {
               if(this.musicpick == 1)
               {
                  this.myChannel1 = this.bgm1.play(0,999);
               }
               else if(this.musicpick == 2)
               {
                  this.myChannel1 = this.bgm2.play(0,999);
               }
               else if(this.musicpick == 3)
               {
                  this.myChannel1 = this.bgm3.play(0,999);
               }
               else if(this.musicpick == 4)
               {
                  this.myChannel1 = this.bgm4.play(0,999);
               }
               else if(this.musicpick == 5)
               {
                  this.myChannel1 = this.bgm5.play(0,999);
               }
               else if(this.musicpick == 6)
               {
                  this.myChannel1 = this.bgm6.play(0,999);
               }
            }
            this.musicplay = 1;
         }
         this.myChannel1.soundTransform = this.myTransform1;
      }
      
      public function playsfx() : void
      {
         this.myTransform2.volume = this.sfxvolume / 10;
         if(this.sfx == 1)
         {
            this.myChannel2 = this.clicksfx.play(0,1);
         }
         else if(this.sfx == 2)
         {
            this.myChannel2 = this.clicksfx2.play(0,1);
         }
         else if(this.sfx == 3)
         {
            this.myChannel2 = this.shinesfx.play(0,1);
         }
         else if(this.sfx == 4)
         {
            this.myChannel2 = this.uisoundsfx.play(0,1);
         }
         else if(this.sfx == 5)
         {
            this.myChannel2 = this.revealsfx.play(0,1);
         }
         else if(this.sfx == 6)
         {
            this.myChannel2 = this.starnormalsfx.play(0,1);
         }
         else if(this.sfx == 7)
         {
            this.myChannel2 = this.star5sfx.play(0,1);
         }
         else if(this.sfx == 8)
         {
            this.myChannel2 = this.star6sfx.play(0,1);
         }
         else if(this.sfx == 9)
         {
            this.myChannel2 = this.lucky5sfx.play(0,1);
         }
         else if(this.sfx == 10)
         {
            this.myChannel2 = this.lucky6sfx.play(0,1);
         }
         this.myChannel2.soundTransform = this.myTransform2;
      }
      
      public function tappinz(evt:MouseEvent) : void
      {
         if(this.mapx != 10)
         {
            this.gocir.gotoAndPlay(1);
            this.gocir.x = mouseX;
            this.gocir.y = mouseY;
            this.gocir.rotation = int(Math.floor(Math.random() * 360) + 1);
            setChildIndex(this.gocir,numChildren - 1);
            this.gocir.mouseChildren = false;
            this.gocir.mouseEnabled = false;
         }
      }
      
      public function generateRandomString(strlen:Number) : String
      {
         var chars:String = "ABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890";
         var num_chars:Number = chars.length - 1;
         var randomChar:String = "";
         for(var i:Number = 0; i < strlen; i++)
         {
            randomChar += chars.charAt(Math.floor(Math.random() * num_chars));
         }
         return randomChar;
      }
      
