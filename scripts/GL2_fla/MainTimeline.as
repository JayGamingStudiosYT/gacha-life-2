      public function getcopystring() : void
      {
         if(this.slotmain == 1)
         {
            this.originalText = this["charstring" + this.slot];
         }
         else if(this.slotmain == 2)
         {
            this.originalText = this["slotstring" + this.slot];
         }
         this.newText = this.originalText.replace(/\r?\n|\r/g," ");
      }
      
      public function getanimationstring() : void
      {
         this.originalText = this["anistring" + this.anipick];
         this.newText = this.originalText.replace(/\r?\n|\r/g," ");
      }
      
