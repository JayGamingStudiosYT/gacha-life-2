         }
         else
         {
            this.notenough.gotoAndPlay(3);
            this.notenough.notx.gotoAndStop(1);
         }
      }
      
      public function gogacha() : void
      {
         var i:* = undefined;
         this.totalpulls += totalgacha;
         for(i = 1; i <= totalgacha; i++)
         {
            this["gacharnd" + i] = Math.floor(Math.random() * 100) + 1;
            if(this["gacharnd" + i] >= 67)
            {
               this["gachaget" + i] = Math.floor(Math.random() * this.max1stars) + 1;
               this["gachatype" + i] = 1;
            }
            else if(this["gacharnd" + i] >= 37 && this["gacharnd" + i] <= 66)
            {
               this["gachaget" + i] = Math.floor(Math.random() * this.max2stars) + 51;
               this["gachatype" + i] = 2;
            }
            else if(this["gacharnd" + i] >= 17 && this["gacharnd" + i] <= 36)
            {
               this["gachaget" + i] = Math.floor(Math.random() * this.max3stars) + 101;
               this["gachatype" + i] = 3;
            }
            else if(this["gacharnd" + i] >= 7 && this["gacharnd" + i] <= 16)
            {
               this["gachaget" + i] = Math.floor(Math.random() * this.max4stars) + 151;
               this["gachatype" + i] = 4;
            }
            else if(this["gacharnd" + i] >= 2 && this["gacharnd" + i] <= 6)
            {
               this["gachaget" + i] = Math.floor(Math.random() * this.max5stars) + 201;
               this["gachatype" + i] = 5;
            }
            else if(this["gacharnd" + i] <= 1)
            {
               this["gachaget" + i] = Math.floor(Math.random() * this.max6stars) + 401;
               this["gachatype" + i] = 6;
               this.total6stars += 1;
            }
         }
         this.gachastars = 0;
         this.gachabest = 1;
         for(i = 1; i <= totalgacha; i++)
         {
            this["gnew" + i] = 1;
            this["gshow" + i] = this["gachaget" + i];
            if(this["unitx" + this["gshow" + i]] == 0)
            {
               this["gnew" + i] = 2;
            }
            this["unitx" + this["gshow" + i]] += 1;
            if(this["gachatype" + i] == 1)
            {
               this.gachastars += 1;
            }
            else if(this["gachatype" + i] == 2)
            {
               this.gachastars += 2;
            }
            else if(this["gachatype" + i] == 3)
            {
               this.gachastars += 5;
            }
            else if(this["gachatype" + i] == 4)
            {
               this.gachastars += 20;
            }
            else if(this["gachatype" + i] == 5)
            {
               this.gachastars += 100;
               if(this.gachabest == 1)
               {
                  this.gachabest = 2;
               }
            }
            else if(this["gachatype" + i] == 6)
            {
               this.gachastars += 1000;
               if(this.gachabest <= 2)
               {
                  this.gachabest = 3;
               }
            }
         }
         this.stars += this.gachastars;
         this.savex();
         this.savex3();
         this.goscene = 9;
         if(this.restartgacha == 2)
         {
            this.firstgacha = 2;
            this.fadex.gotoAndPlay("gfadeout2");
         }
         else
         {
            this.myChannel1.stop();
            this.firstgacha = 2;
            this.musicplay = 2;
            this.musicpick = 2;
            this.musicplayer();
            this.fadex.gotoAndPlay("gfadeout");
         }
      }
      
