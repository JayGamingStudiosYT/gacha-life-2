      public function updatetext() : void
      {
         var ii:* = undefined;
         var i:* = undefined;
         if(this.smainchat == 0)
         {
            this.chattext.visible = false;
         }
         else
         {
            this.chattext.visible = true;
            this.chattext.x = this.smainchatxpos + 250;
            this.chattext.y = this.smainchatypos + 480;
            this.chattext.rotation = this.smainchatrot;
            this.chattext.scaleX = this.smainchatscale * 0.1;
            this.chattext.scaleY = this.smainchatscale * 0.1;
            this.chattext.c1.text = this.smainchatmsg;
            if(this.chattext.c1.numLines == 1)
            {
               this.chattext.c1.y = -26;
            }
            for(ii = 2; ii <= 4; ii++)
            {
               if(this.chattext.c1.numLines == 2)
               {
                  this.chattext.c1.y = -44;
                  this.chattext["c" + ii].gotoAndStop(4);
               }
               else if(this.chattext.c1.numLines >= 3)
               {
                  this.chattext.c1.y = -59;
                  this.chattext["c" + ii].gotoAndStop(5);
               }
               else if(this.chattext.c1.length <= 10)
               {
                  this.chattext["c" + ii].gotoAndStop(1);
               }
               else if(this.chattext.c1.length >= 11 && this.chattext.c1.length <= 20)
               {
                  this.chattext["c" + ii].gotoAndStop(2);
               }
               else
               {
                  this.chattext["c" + ii].gotoAndStop(3);
               }
            }
            this.ggcolor1.setTint("0x" + this.smainchatcolx1,1);
            this.ggcolor2.setTint("0x" + this.smainchatcolx2,1);
            this.ggcolor3.setTint("0x" + this.smainchatcolx3,1);
            this.ggcolor4.setTint("0x" + this.smainchatcolx4,1);
            this.chattext.c1.transform.colorTransform = this.ggcolor1;
            this.chattext.c2.transform.colorTransform = this.ggcolor2;
            this.chattext.c3.transform.colorTransform = this.ggcolor3;
            this.chattext.c4.transform.colorTransform = this.ggcolor4;
            for(i = 2; i <= 4; i++)
            {
               if(this.smainchat == 1)
               {
                  this.chattext["c" + i].alpha = 1;
               }
               else if(this.smainchat == 2)
               {
                  this.chattext["c" + i].alpha = 0.8;
               }
               else if(this.smainchat == 3)
               {
                  this.chattext["c" + i].alpha = 0.6;
               }
               else if(this.smainchat == 4)
               {
                  this.chattext["c" + i].alpha = 0.4;
               }
               else if(this.smainchat == 5)
               {
                  this.chattext["c" + i].alpha = 0.2;
               }
            }
         }
      }
      
