            this.savemaxgifts = this.maxgifts;
            this.savefeat = data.Featured;
            this.savedb = this.nowcode1;
            this.savedb_weekly = this.nowcode2;
            this.savedb_gachatubers = this.nowcode3;
            this.savex5();
            this.checkNumDB2();
            event.currentTarget.removeEventListener(Event.COMPLETE,this.handleComplete);
         }
         else if(this.handlepick == 3)
         {
            this.fadex.gotoAndPlay("loadfadeout");
