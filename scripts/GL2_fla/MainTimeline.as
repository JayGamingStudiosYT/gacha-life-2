      public function checkskew() : void
      {
         var skewMatrix:Matrix = null;
         var transform:Transform = this.newgg.transform;
         this.initialX = this.newgg.x;
         this.initialY = this.newgg.y;
         skewMatrix = new Matrix();
         skewMatrix.a = this.scaleskew;
         skewMatrix.b = Math.tan(this.skewy * 0.03);
         skewMatrix.c = Math.tan(this.skewx * 0.03);
         skewMatrix.d = this.scaleskew;
         skewMatrix.tx = this.initialX;
         skewMatrix.ty = this.initialY;
         this.newgg.transform.matrix = skewMatrix;
      }
      
      public function updategloves() : void
      {
         var i:* = undefined;
         var ii:* = undefined;
         for(i = 1; i <= 2; i++)
         {
            if(i == 1)
            {
               this.ggg = this.gg.char.handx.handx;
            }
            else if(i == 2)
            {
               this.ggg = this.gg.char.backhand.handx;
            }
            for(ii = 1; ii <= 4; ii++)
            {
               this.ggg.handx.handx.glove["c" + ii].gotoAndStop(this["glovego1x" + i + "x" + this["glove" + i + "x"]] + this["hand" + i + "x"]);
               this.ggg.handx.glove["c" + ii].gotoAndStop(this["glovego2x" + i + "x" + this["glove" + i + "x"]]);
            }
         }
      }
      
