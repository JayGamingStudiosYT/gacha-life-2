      public function checkmax() : void
      {
         if(this.changetype == 2)
         {
            this.maxx = 40;
            this.minx = -40;
         }
         else if(this.changetype == 3)
         {
            this.maxx = 1000;
            this.minx = -1000;
         }
         else if(this.changetype == 4)
         {
            this.maxx = 360;
            this.minx = 0;
         }
         else if(this.changetype == 5)
         {
            this.maxx = 30;
            this.minx = -30;
         }
         else if(this.changex == "shadow")
         {
            this.maxx = this.maxshadow;
            this.minx = 0;
         }
         else if(this.changex == "posepage" && this.posetypepage == 1)
         {
            this.maxx = 50;
            this.minx = 1;
         }
         else if(this.changex == "posepage" && this.posetypepage == 2)
         {
            if(this.animode == 1)
            {
               this.maxx = 10;
            }
            else
            {
               this.maxx = 50;
            }
            this.minx = 1;
         }
         else if(this.changex == "tintchar")
         {
            this.maxx = 20;
            this.minx = 0;
         }
         else if(this.changex == "headshape")
         {
            this.maxx = this.maxheadshape;
            this.minx = 0;
         }
         else if(this.changex == "ear1")
         {
            this.maxx = this.maxear;
            this.minx = 0;
         }
         else if(this.changex == "ear2")
         {
