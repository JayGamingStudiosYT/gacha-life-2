      public function resumegacha() : void
      {
         this.pausegacha = 1;
         this.gachas["gachax" + gachashow].gotoAndStop("end");
         gachashow += 1;
         timer = 5;
         if(gachashow > totalgacha)
         {
            removeEventListener(Event.ENTER_FRAME,this.gachaResultsplay);
            this.gacharesultbts.visible = true;
            this.gacharesultbts.gotoAndPlay(3);
         }
         else
         {
            addEventListener(Event.ENTER_FRAME,this.gachaResultsplay);
         }
      }
      
      public function showgachachar() : void
      {
         this.skipbt.visible = false;
         this.revealgo.gotoAndStop(3);
         if(this["gachatype" + gachashow] <= 4)
         {
            this.sfx = 6;
            this.playsfx();
         }
         else if(this["gachatype" + gachashow] == 5)
         {
            this.sfx = 7;
            this.playsfx();
         }
         else if(this["gachatype" + gachashow] == 6)
         {
            this.sfx = 8;
            this.playsfx();
         }
         this.chartype = 8;
         this.unitstype = 1;
         if(this.lag == 1)
         {
            this.playani = 2;
         }
         this.oldslot = this.slot;
         this.onlyicon = 1;
         this.onlycolor = 1;
         this.doskew = 2;
         this.docolor = 2;
         this.slot = gchar;
         trace(this.slot);
         this.getplayerstring();
         this.revealgo.revealx.namex.namex.text = this.namex;
         this.revealgo.revealx.starx.gotoAndStop(this["gachatype" + gachashow]);
         if(this["gnew" + gachashow] == 1)
         {
            this.revealgo.revealx.newx.visible = false;
         }
         else if(this["gnew" + gachashow] == 2)
         {
            this.revealgo.revealx.newx.visible = true;
         }
         this.updatechar();
         this.unitstring = this.udata;
         this.slot = this.oldslot;
         this.chartype = 1;
      }
      
      public function gachaResultsplay(event:Event) : void
      {
         timer = timer - 1;
         if(timer < 1)
         {
            if(this.gachapart == 1)
            {
               this.gachas["gachax" + gachashow].gotoAndPlay("show1");
               gachashow += 1;
               timer = 5;
               if(gachashow > totalgacha)
               {
                  gachashow = 1;
                  this.gachapart = 2;
               }
            }
            else if(this.gachapart == 2)
            {
               if(this["gachatype" + gachashow] >= 5 || this["gnew" + gachashow] == 2)
               {
                  gchar = this["gshow" + gachashow];
                  this.gachas["gachax" + gachashow].gotoAndPlay("show3");
                  this.pausegacha = 2;
                  this.skipbt.visible = false;
                  removeEventListener(Event.ENTER_FRAME,this.gachaResultsplay);
               }
               if(this.pausegacha == 1)
               {
                  this.sfx = 4;
                  this.playsfx();
                  this.gachas["gachax" + gachashow].gotoAndPlay("show2");
                  gachashow += 1;
                  timer = 5;
                  if(gachashow > totalgacha)
                  {
                     removeEventListener(Event.ENTER_FRAME,this.gachaResultsplay);
                     this.gacharesultbts.visible = true;
                     this.gacharesultbts.gotoAndPlay(3);
                     this.skipbt.visible = false;
                  }
               }
            }
         }
      }
      
