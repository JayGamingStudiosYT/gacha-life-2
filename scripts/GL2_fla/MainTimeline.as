      public function checkgacha() : void
      {
         trace("checkgacha");
         if(totalgacha == 1 && this.gems >= 10)
         {
            this.gems -= 10;
            this.gogacha();
         }
         else if(totalgacha == 10 && this.gems >= 100)
         {
            this.gems -= 100;
