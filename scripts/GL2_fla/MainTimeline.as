      public function changego() : void
      {
         this.checkmax();
         this.changetimer = 0;
         this.changetimes = 4;
         if(this.changedir == 1)
         {
            stage.addEventListener(Event.ENTER_FRAME,this.changingleft);
         }
         else if(this.changedir == 2)
         {
            stage.addEventListener(Event.ENTER_FRAME,this.changingright);
         }
         else
         {
            stage.addEventListener(Event.ENTER_FRAME,this.changingother);
         }
         this.holdblocker.gotoAndStop(3);
      }
      
      public function holdblockerx(evt:MouseEvent) : void
      {
         if(this.hideui == 1)
         {
            this.holdblocker.gotoAndStop(2);
            if(this.custpage == 1)
            {
               this.custx.presetsel.gotoAndStop("none");
            }
            else if(this.custpage == 2)
            {
               this.custx.bodysel.gotoAndStop("none");
            }
            else if(this.custpage == 3)
            {
               this.custx.posesel2.gotoAndStop("none");
            }
            else if(this.custpage == 4)
            {
               this.custx.moresel.gotoAndStop("none");
            }
            else if(this.custpage >= 5 && this.custpage <= 17)
            {
               this.custx.assetsel.gotoAndStop("none");
            }
            else if(this.custpage == 18)
            {
               this.custx.profilesel.gotoAndStop("none");
            }
            else if(this.custpage == 19)
            {
               this.custx.itempicksel.gotoAndStop("none");
            }
            else if(this.custpage == 20)
            {
               this.custx.adjustsel.gotoAndStop("none");
               this.custx.movex.gotoAndStop(1);
            }
            stage.removeEventListener(Event.ENTER_FRAME,this.changingright);
            stage.removeEventListener(Event.ENTER_FRAME,this.changingleft);
            stage.removeEventListener(Event.ENTER_FRAME,this.changingother);
            stage.removeEventListener(Event.ENTER_FRAME,this.rotatecircle);
            this.oldxpos2 = "";
         }
         else if(this.hideui >= 2)
         {
            if(this.lag == 1)
            {
               stage.quality = StageQuality.MEDIUM;
            }
            else if(this.lag == 2)
            {
               stage.quality = StageQuality.LOW;
            }
            this.holdblocker.gotoAndStop(2);
            if(this.hideui == 2)
            {
               this.custx.visible = true;
            }
            else if(this.hideui == 3)
            {
               this.ui.visible = true;
               this.botbarhome.visible = true;
               this.custx.visible = true;
            }
            this.hideui = 1;
            this.updatezoom();
         }
      }
      
