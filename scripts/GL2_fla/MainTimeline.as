      public function joinmap() : *
      {
         trace(this.goscene);
         this.savex();
         trace(this.fadex);
         if(this.goscene == 3)
         {
            this.myChannel1.stop();
            gotoAndStop("load");
         }
         else if(this.goscene == 4)
         {
            gotoAndStop("home");
         }
         else if(this.goscene == 5)
         {
            gotoAndStop("featuredchars");
         }
         else if(this.goscene == 6)
         {
            gotoAndStop("life");
         }
         else if(this.goscene == 7)
         {
            gotoAndStop("gacha");
         }
         else if(this.goscene == 8)
         {
            gotoAndStop("collection");
         }
         else if(this.goscene == 9)
         {
            gotoAndStop("gachaani");
         }
         else if(this.goscene == 10)
         {
            gotoAndStop("studio");
         }
         this.goscene = 0;
         if(this.firstgacha == 2)
         {
            this.fadex.gotoAndPlay("gfadein");
         }
         else
         {
            trace("fade in");
            this.fadex.gotoAndPlay("fadein");
         }
      }
      
      public function updatedatatimer(event:Event) : void
      {
         if(this.datatimer > 1)
         {
            --this.datatimer;
         }
         else
         {
            this.datatimer = 0;
            stage.removeEventListener(Event.ENTER_FRAME,this.updatedatatimer);
         }
      }
      
      public function adddatatime() : void
      {
         if(this.cheese == 2)
         {
            this.datatimer = 5;
         }
         else
         {
            this.datatimer = 150;
         }
         stage.addEventListener(Event.ENTER_FRAME,this.updatedatatimer);
      }
      
      public function initialisedHandler(event:AdvertsEvent) : void
      {
         this._setupComplete = true;
      }
      
      public function handleRewardedVideoAd() : void
      {
         if(this.adcomplete == 1)
         {
            if(Adverts.service.rewardedVideoAds.isSupported)
            {
               if(this.mapx == 4 || this.mapx == 7)
               {
                  this.watchadgo.gotoAndStop(4);
               }
               this.adready = 1;
               this.adcomplete = 2;
               this.rewardedVideoAd.load(new AdRequestBuilder().build());
               this.rewardedVideoAd.addEventListener(RewardedVideoAdEvent.LOADED,this.rewardVideo_loadedHandler);
               this.rewardedVideoAd.addEventListener(RewardedVideoAdEvent.ERROR,this.rewardVideo_errorHandler);
            }
            else
            {
               this.adready = 1;
               this.adcomplete = 2;
               this.adcomplete = 2;
               if(this.mapx == 4 || this.mapx == 7)
               {
                  this.watchadgo.gotoAndStop(2);
               }
               if(this.mapx == 4)
               {
                  this.char.visible = true;
               }
               trace("Reward Video Ads not supported");
            }
         }
      }
      
