         for(i = 1; i <= 16; i++)
         {
            if(this["scharon" + i] == 2)
            {
               this["schar" + i].mouseChildren = false;
               this["schar" + i].mouseEnabled = false;
               this["schar" + i].visible = true;
               this["schar" + i].x = this["scharxpos" + i];
               this["schar" + i].y = this["scharypos" + i];
               this["schar" + i].rotation = this["scharrot" + i];
               this["schar" + i].scaleX = this["scharscale" + i] * 0.25 * this["scharflip" + i];
               this["schar" + i].scaleY = this["scharscale" + i] * 0.25;
               if(this["scharemote" + i] == 1)
               {
                  this["emote" + i].visible = false;
               }
               else
               {
                  this["emote" + i].visible = true;
                  this["emote" + i].gotoAndStop(this["scharemote" + i]);
