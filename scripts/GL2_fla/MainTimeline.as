      public function startrotate() : void
      {
         this.holdblocker.gotoAndStop(3);
         stage.addEventListener(Event.ENTER_FRAME,this.rotatecircle);
      }
      
      public function rotatecircle(e:Event) : void
      {
         var radians:Number = NaN;
         var degrees:int = 0;
         var i:* = undefined;
         var dx:Number = NaN;
         var dy:Number = NaN;
         if(this.layout == 1)
         {
            dx = mouseX - 430;
            dy = mouseY - 703;
         }
         else if(this.layout == 2)
         {
            dx = mouseX - 719;
            dy = mouseY - 563;
         }
         else if(this.layout == 3)
         {
            dx = mouseX - 946;
            dy = mouseY - 557;
         }
         radians = Math.atan2(dy,dx);
         degrees = radians * 180 / Math.PI + 90;
         this.custx.rotationshow.rotx.rotation = degrees;
         if(degrees < 0)
         {
            degrees += 360;
         }
         this[this.changex + ""] = degrees;
         for(i = 2; i <= 8; i++)
         {
            if(this["oldxpos" + i] != "")
            {
               if(this["reverse" + i] == 1)
               {
                  this[this["oldxpos" + i] + ""] = degrees;
               }
               else
               {
                  this[this["oldxpos" + i] + ""] = 360 - degrees;
               }
            }
         }
         this.updatecustinfo();
         this.updatechar();
      }
      
      public function changetiming() : void
      {
         if(this.changetimes == 4)
         {
            this.changetimes = 3;
            this.changetimer = 6;
         }
         else if(this.changetimes == 3)
         {
            this.changetimes = 2;
            this.changetimer = 5;
         }
         else if(this.changetimes == 2)
         {
            this.changetimes = 1;
            this.changetimer = 4;
         }
         else if(this.changetimes == 1)
         {
            this.changetimes = 0;
            this.changetimer = 3;
         }
         else if(this.changetimes == 0)
         {
            this.changetimer = 2;
         }
      }
      
