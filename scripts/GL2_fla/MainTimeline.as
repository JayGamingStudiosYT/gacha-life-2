            this.updatelayout2();
            this.openslots = 5;
            this.updatesloticonsgo();
            this.goedit = 1;
         }
         else if(this.goedit == 3)
         {
            this.custpage = 7;
            this.updatecustinfo();
            this.updatelayout2();
            this.openslots = 5;
            this.updatesloticonsgo();
            this.goedit = 1;
         }
      }
      
