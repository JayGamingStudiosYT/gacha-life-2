      public function confirm4() : void
      {
         if(parent.posetypepage == 1)
         {
            parent.offani();
            parent.posex = parent.ipick + (parent.posepagex * 12 - 12);
            parent.posepick = parent.ipick + (parent.posepagex * 12 - 12);
         }
         else if(parent.posetypepage == 2)
         {
            if(parent.animode == 1)
            {
               parent.anipick = parent.ipick + (parent.posepagex * 12 - 12);
               this.checkposesel();
            }
            else if(parent.animode == 2)
            {
               parent.posepick = parent.ipick + (parent.posepagex * 12 - 12);
               parent.getposestring();
               parent.saveposeani();
               parent.getplayerstring();
            }
            parent.onani();
            this.posebodyadj2.speedx.text = parent.anispeedx + "/15";
            this.posebodyadj2.framex.text = parent.currentframe + "/" + parent.aniframes;
            parent.updateposethumb();
         }
         if(parent.posetypepage == 1)
         {
            parent.updateposes = 2;
            parent.getposestring();
            parent.updatechar();
            parent.saveplayerstring();
            parent.updatecustinfo();
            trace(parent.posex);
         }
      }
      
      public function checkposesel() : void
      {
         if(parent.posetypepage == 1)
         {
            if(parent.posex == 0)
            {
               this.poseselx.visible = false;
            }
            else if(parent.posex > parent.posepagex * 12 - 12 && parent.posex <= parent.posepagex * 12)
            {
               this.poseselx.visible = true;
               this.poseselx.x = this["posebt" + (parent.posex - (parent.posepagex * 12 - 12))].x;
               this.poseselx.y = this["posebt" + (parent.posex - (parent.posepagex * 12 - 12))].y;
            }
            else
            {
               this.poseselx.visible = false;
            }
         }
         else if(parent.posetypepage == 2 && parent.animode == 1)
         {
            if(parent.anipick == 0)
            {
               this.poseselx.visible = false;
            }
            else if(parent.anipick > parent.posepagex * 12 - 12 && parent.anipick <= parent.posepagex * 12)
            {
               this.poseselx.visible = true;
               this.poseselx.x = this["posebt" + (parent.anipick - (parent.posepagex * 12 - 12))].x;
               this.poseselx.y = this["posebt" + (parent.anipick - (parent.posepagex * 12 - 12))].y;
            }
            else
            {
               this.poseselx.visible = false;
            }
         }
         else
         {
            this.poseselx.visible = false;
         }
      }
      
