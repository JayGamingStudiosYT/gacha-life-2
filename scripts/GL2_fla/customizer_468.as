      public function mouseclickxa(evt:MouseEvent) : void
      {
         this.mouseclicka.gotoAndStop(2);
         this.mousedown = 2;
         addEventListener(Event.ENTER_FRAME,this.colorloop);
      }
      
      public function mouseclickxxa(evt:MouseEvent) : void
      {
         this.mouseclicka.gotoAndStop(1);
         this.mousedown = 1;
         removeEventListener(Event.ENTER_FRAME,this.colorloop);
      }
      
      public function colorloop(e:Event) : void
      {
         var i:* = undefined;
         for(i = 1; i <= 336; i++)
         {
            if(this.colorbox["colorbt" + i].hitTestPoint(stage.mouseX,stage.mouseY,true))
            {
               this.colorpick = i;
               if(this.checkcolor != this.colorpick)
               {
                  this.colorbox.coloron.visible = true;
                  this.colorbox.coloron.x = this.colorbox["colorbt" + i].x;
                  this.colorbox.coloron.y = this.colorbox["colorbt" + i].y;
                  this.checkcolor = this.colorpick;
                  this.newcolor();
                  trace("newcolor" + this.checkcolor);
               }
            }
         }
      }
      
      public function newcolor() : void
      {
         /*
          * Decompilation error
          * Code may be obfuscated
          * Tip: You can try enabling "Deobfuscate code" option in Settings
          * Error type: ExecutionException (java.lang.StackOverflowError)
          */
         throw new flash.errors.IllegalOperationError("Not decompiled due to error");
      }
      
      public function importbackbtx(event:MouseEvent) : void
      {
         parent.sfx = 1;
         parent.playsfx();
         parent.custpage = 18;
         parent.updatecustinfo();
         parent.saveplayerstring();
      }
      
      public function updateexporthistory() : void
      {
         var i:* = undefined;
         for(i = 1; i <= 7; i++)
         {
            if(parent["exportname" + (i + (this.historypage * 7 - 7))] != "")
            {
               this["exporthistory" + i].visible = true;
               this["exporthistory" + i].namex.text = parent["exportname" + (i + (this.historypage * 7 - 7))];
            }
            else
            {
               this["exporthistory" + i].visible = false;
            }
         }
         this.historypagea.pagex.text = "Page " + this.historypage + "/10";
      }
      
