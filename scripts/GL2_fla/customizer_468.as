      public function checkswitch() : void
      {
         this.page = parent.custpage;
         this.switchbt1.visible = true;
         this.switchbt2.visible = true;
         this.switchbt3.visible = true;
         this.switchbt4.visible = false;
         this.switchbt5.visible = false;
         this.switchbt6.visible = false;
         this.switchbt7.visible = false;
         if(this.page == 5)
         {
            this.switchbt1.visible = false;
            this.switchbt2.visible = false;
         }
         else if(this.page == 6)
         {
            this.switchbt1.visible = false;
         }
         else if(this.page != 7)
         {
            if(this.page == 8)
            {
               this.switchbt3.visible = false;
            }
            else if(this.page == 9)
            {
               this.switchbt6.visible = true;
               this.switchbt7.visible = true;
            }
            else if(this.page != 10)
            {
               if(this.page == 11)
               {
                  this.switchbt1.visible = false;
                  this.switchbt2.visible = false;
               }
               else if(this.page != 12)
               {
                  if(this.page != 13)
                  {
                     if(this.page != 14)
                     {
                        if(this.page != 15)
                        {
                           if(this.page == 16)
                           {
                              this.switchbt3.visible = false;
                              this.switchbt4.visible = true;
                              this.switchbt5.visible = true;
                           }
                           else if(this.page == 17)
                           {
                              this.switchbt6.visible = true;
                              this.switchbt7.visible = true;
                           }
                        }
                     }
                  }
               }
            }
         }
      }
      
